CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_GRUB_TIMEOUT="3"
CONFIG_GRUB_TITLE="Mrouter-OS"
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

CONFIG_PACKAGE_mrouter-core=y
CONFIG_PACKAGE_luci-app-mrouter=y
CONFIG_PACKAGE_luci-theme-mrouter=y
CONFIG_PACKAGE_mrouter-setup=y
CONFIG_PACKAGE_mrouter-os=y

# Modern LuCI / HTTPS. Keep upstream configuration pages, but Mrouter owns the theme/navigation.
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_cgi-io=y

# DNS / filtering / policy routing.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_https-dns-proxy=y
CONFIG_PACKAGE_pbr=y

# VPN.
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_OPENVPN_openssl_ENABLE_LZ4=y
CONFIG_OPENVPN_openssl_ENABLE_LZO=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_kmod-tun=y

# Traffic accounting / SQM.
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_tc-tiny=y

# x86 Ethernet coverage: Intel, Realtek and Aquantia common router NICs.
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-atlantic=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y

# Diagnostics and appliance maintenance.
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_nvme-cli=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-nvme=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_HTOP_LMSENSORS=y
CONFIG_PACKAGE_block-mount=y

# Deliberately omitted from base v1.0: StrongSwan/IPsec, collectd/RRD/Netlink,
# vnStat, Netify DPI, mwan3, UPnP, travelmate/wireless UI, SmartDNS, Stubby,
# stock DDNS UI/scripts, sing-box/Xray/v2rayA, ZeroTier, OpenConnect/FortiVPN,
# watchcat, irqbalance, extra themes and redundant stock VPN LuCI frontends.
