{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board');

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="{{ media }}/cascade.css?v=26.180.75667~128a781">
<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
{% if (node?.css): %}
<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
{% endif %}
<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
<script src="{{ resource }}/cbi.js?v=26.180.75667~128a781"></script>
<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
{% if (css): %}
<style title="text/css">{{ css }}</style>
{% endif %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    function alertText(el) { return (el && el.textContent || '').replace(/\s+/g, ' ').trim(); }
    function reconcilePasswordNotice() {
        var alerts = Array.prototype.slice.call(document.querySelectorAll('.alert-message'));
        var changed = alerts.some(function(a) { return /password has been successfully changed/i.test(alertText(a)); });
        if (changed) {
            alerts.forEach(function(a) {
                if (/No password set!/i.test(alertText(a))) a.remove();
            });
        }
    }

    function stabilizeSidebar() {
        var menu = document.getElementById('mainmenu');
        var left = document.querySelector('.main-left');
        var mask = document.querySelector('.darkMask');

        if (menu) {
            menu.style.pointerEvents = 'auto';
            menu.style.userSelect = 'auto';
        }

        if (left) {
            left.style.pointerEvents = 'auto';
        }

        if (mask && window.matchMedia('(min-width: 851px)').matches) {
            mask.style.pointerEvents = 'none';
            mask.style.display = 'none';
        }
    }

    var lastParent = null;
    var lastParentAt = 0;

    document.addEventListener('click', function(ev) {
        var btn = ev.target && ev.target.closest ? ev.target.closest('button, a.btn, .cbi-button') : null;
        if (btn && /^dismiss$/i.test((btn.textContent || '').trim())) {
            var alert = btn.closest('.alert-message, .alert-message.notice, .alert-message.warning, .alert-message.error');
            if (alert) {
                ev.preventDefault();
                alert.remove();
                return;
            }
        }

        var a = ev.target && ev.target.closest ? ev.target.closest('#mainmenu a') : null;
        if (!a) return;

        var li = a.parentElement;
        var hasSubmenu = false;
        if (li) {
            for (var i = 0; i < li.children.length; i++) {
                if (li.children[i].tagName === 'UL') {
                    hasSubmenu = true;
                    break;
                }
            }
        }

        if (!hasSubmenu) {
            window.setTimeout(stabilizeSidebar, 0);
            return;
        }

        var now = Date.now();
        if (lastParent === a && (now - lastParentAt) < 350) {
            ev.preventDefault();
            ev.stopImmediatePropagation();
            stabilizeSidebar();
            return;
        }

        lastParent = a;
        lastParentAt = now;
        window.setTimeout(stabilizeSidebar, 0);
        window.setTimeout(stabilizeSidebar, 300);
    }, true);

    document.addEventListener('dblclick', function(ev) {
        var a = ev.target && ev.target.closest ? ev.target.closest('#mainmenu a') : null;
        if (!a) return;
        var li = a.parentElement;
        if (!li) return;
        for (var i = 0; i < li.children.length; i++) {
            if (li.children[i].tagName === 'UL') {
                ev.preventDefault();
                ev.stopImmediatePropagation();
                stabilizeSidebar();
                return;
            }
        }
    }, true);

    reconcilePasswordNotice();
    stabilizeSidebar();
    window.addEventListener('resize', stabilizeSidebar);
    new MutationObserver(function() {
        reconcilePasswordNotice();
        stabilizeSidebar();
    }).observe(document.body, { childList: true, subtree: true });
});
</script>
</head>
<body class="lang_{{ dispatcher.lang }} {{ ctx.authsession ? 'logged-in' : '' }} {{ length(ctx.path) ? `node-${join('-', ctx.path)}` : 'node-main-login' }}" data-page="{{ entityencode(join('-', ctx.path), true) }}">
<header>
	<div class="fill">
		<div class="container">
			<span class="showSide"></span>
<a id="logo" href="{{ ctx.authsession ? dispatcher.build_url('admin/dashboard') : '#' }}" aria-label="Mrouter-OS"><svg class="mrouter-header-logo" viewBox="0 0 64 64" aria-hidden="true"><rect x="3" y="3" width="58" height="58" rx="16" fill="#007AFF"/><path d="M16 44V20L32 35L48 20V44" fill="none" stroke="#fff" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
<a class="brand" href="#">Mrouter-OS</a>
			<span class="status" id="indicators"></span>
		</div>
	</div>
</header>
<div class="main">
	<div style="" class="loading"><span><div class="loading-img"></div>{{ _('Collecting data...') }}</span></div>
	<div class="main-left" id="mainmenu" style="display:none"></div>
	<div class="main-right">
		<div class="modemenu-buttons" style="display:none">
			<ul id="modemenu"></ul>
		</div>
		<div class="darkMask"></div>
		<div id="maincontent">
			<div class="container">
				{% if (getuid() == 0 && getspnam('root')?.pwdp === '' && ctx.authsession): %}
					<div class="alert-message warning">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/advanced/administration/password")): %}
						  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/advanced/administration/password") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
				{% endif %}

				{% if (boardinfo?.rootfs_type == "initramfs"): %}
					<div class="alert-message warning">
						<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
						<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
						{% if (dispatcher.lookup("admin/advanced/administration/backup")): %}
						  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/advanced/administration/backup") }}">{{ _('Go to firmware upgrade...') }}</a></div>
						{% endif %}
					</div>
				{% endif %}

				<noscript>
					<div class="alert-message warning">
						<h4>{{ _('JavaScript required!') }}</h4>
						<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
					</div>
				</noscript>

				<div id="tabmenu" style="display:none"></div>
