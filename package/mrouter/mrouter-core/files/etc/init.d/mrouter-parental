#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/libexec/mrouter-parental-loop
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger mrouterparental network firewall
}

reload_service() {
    /usr/libexec/mrouter-parental apply >/dev/null 2>&1 || true
}

stop_service() {
    nft delete table inet mrouter_parental >/dev/null 2>&1 || true
    rm -f /tmp/mrouter-parental.state
}
