#!/bin/sh
# Package-first initialisation. Never rewrite existing WAN/LAN/DHCP/firewall/VLAN topology here.
uci -q get mrouter.system >/dev/null 2>&1 || uci set mrouter.system='system'
uci -q get mrouter.ports >/dev/null 2>&1 || uci set mrouter.ports='ports'
if [ "$(uci -q get mrouter.system.initialized)" = 1 ]; then /usr/libexec/mrouter-migrate >/dev/null 2>&1 || true; exit 0; fi
uci set mrouter.system.version='1.1.0'; uci set mrouter.system.channel='development'; uci set mrouter.system.schema='1300'; uci set mrouter.system.initialized='1'; uci set mrouter.system.setup_complete='0'; uci set mrouter.ports.initialized='0'; uci set mrouter.ports.pending_reboot='0'
uci -q get mrouterparental.config >/dev/null 2>&1 || uci set mrouterparental.config='parental'; [ -n "$(uci -q get mrouterparental.config.enabled)" ] || uci set mrouterparental.config.enabled='0'
uci -q get mrouterfilter.config >/dev/null 2>&1 || uci set mrouterfilter.config='filter'; [ -n "$(uci -q get mrouterfilter.config.enabled)" ] || uci set mrouterfilter.config.enabled='0'; [ -n "$(uci -q get mrouterfilter.config.force_dns)" ] || uci set mrouterfilter.config.force_dns='0'; [ -n "$(uci -q get mrouterfilter.config.block_dot)" ] || uci set mrouterfilter.config.block_dot='0'
uci -q get mrouterservices.main >/dev/null 2>&1 || uci set mrouterservices.main='general'; [ -n "$(uci -q get mrouterservices.main.dns_mode)" ] || uci set mrouterservices.main.dns_mode='mrouter'; [ -n "$(uci -q get mrouterservices.main.pihole_port)" ] || uci set mrouterservices.main.pihole_port='53'
uci -q get mrouterevents.main >/dev/null 2>&1 || uci set mrouterevents.main='settings'; uci set mrouterevents.main.enabled='1'; uci set mrouterevents.main.new_device='1'; uci set mrouterevents.main.wan='1'; uci set mrouterevents.main.vpn='1'
uci -q get mrouterclients.main >/dev/null 2>&1 || uci set mrouterclients.main='settings'; uci set mrouterclients.main.quarantine_new='0'
uci -q get mrouterwan.main >/dev/null 2>&1 || uci set mrouterwan.main='settings'; uci set mrouterwan.main.enabled='0'; uci set mrouterwan.main.primary='wan'; uci set mrouterwan.main.mode='failover'
# PBR stays opt-in. Encrypted DNS is no longer installed or enabled implicitly.
if uci -q get pbr.config >/dev/null 2>&1; then [ -n "$(uci -q get pbr.config.enabled)" ] || uci set pbr.config.enabled='0'; [ -n "$(uci -q get pbr.config.strict_enforcement)" ] || uci set pbr.config.strict_enforcement='0'; dnsmasq --version 2>/dev/null|grep -qi nftset && { [ -n "$(uci -q get pbr.config.resolver_set)" ] || uci set pbr.config.resolver_set='dnsmasq.nftset'; }; uci commit pbr; fi
if uci -q get nlbwmon.@nlbwmon[0] >/dev/null 2>&1; then uci set nlbwmon.@nlbwmon[0].refresh_interval='5s'; uci set nlbwmon.@nlbwmon[0].commit_interval='24h'; uci commit nlbwmon; fi
uci commit mrouter; uci commit mrouterparental; uci commit mrouterfilter; uci commit mrouterservices; uci commit mrouterevents; uci commit mrouterclients; uci commit mrouterwan
for S in mrouter-connectivity mrouter-ddns mrouter-policy-monitor mrouter-ttyd mrouter-parental mrouter-content-filter mrouter-observer; do /etc/init.d/$S enable >/dev/null 2>&1 || true; done
exit 0
