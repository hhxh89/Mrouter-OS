#!/bin/sh
ACTION="${1:-snapshot}"
case "$ACTION" in snapshot|snapshot-lan|snapshot-iot|snapshot-all) ;; *) exit 1;; esac
. /lib/functions/network.sh 2>/dev/null || true
LANDEV=''; IOTDEV=''; WANDEV=''; LANIP=''; IOTIP=''; WANGW=''
network_get_device LANDEV lan 2>/dev/null || true
network_get_device IOTDEV iot 2>/dev/null || true
network_get_device WANDEV wan 2>/dev/null || true
network_get_ipaddr LANIP lan 2>/dev/null || true
network_get_ipaddr IOTIP iot 2>/dev/null || true
WANGW="$(ip -4 route show default 2>/dev/null | awk '/default/{for(i=1;i<=NF;i++)if($i=="via"){print $(i+1);exit}}')"
[ -n "$LANDEV" ] || LANDEV="$(uci -q get network.lan.device || uci -q get network.lan.ifname || true)"
[ -n "$IOTDEV" ] || IOTDEV="$(uci -q get network.iot.device || uci -q get network.iot.ifname || true)"
[ -n "$WANDEV" ] || WANDEV="$(uci -q get network.wan.device || uci -q get network.wan.ifname || true)"
wanted_dev(){ D="$1"; case "$ACTION" in snapshot|snapshot-lan) [ -n "$LANDEV" ] && [ "$D" = "$LANDEV" ];; snapshot-iot) [ -n "$IOTDEV" ] && [ "$D" = "$IOTDEV" ];; snapshot-all) [ "$D" != "$WANDEV" ];; esac; }
valid_mac(){ printf '%s\n' "$1" | grep -Eqi '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' && [ "$(printf '%s' "$1" | tr 'a-f' 'A-F')" != '00:00:00:00:00:00' ]; }
TMP="/tmp/mrouter-client-data.$$"
trap 'rm -f "$TMP"' EXIT INT TERM
: >"$TMP"
ip -4 neigh show 2>/dev/null | while IFS= read -r LINE; do
  set -- $LINE; IP="$1"; MAC=''; DEV=''; PREV=''
  for X in $LINE; do [ "$PREV" = lladdr ] && MAC="$X"; [ "$PREV" = dev ] && DEV="$X"; PREV="$X"; done
  STATE="$(printf '%s\n' "$LINE"|awk '{print $NF}')"
  [ -n "$MAC" ] || continue
  valid_mac "$MAC" || continue
  wanted_dev "$DEV" || continue
  [ "$IP" = "$LANIP" ] && continue
  [ "$IP" = "$IOTIP" ] && continue
  [ "$IP" = "$WANGW" ] && continue
  MACU="$(printf '%s' "$MAC"|tr 'a-f' 'A-F')"
  printf 'N|%s|%s|%s|%s\n' "$IP" "$MACU" "$STATE" "$DEV"
  printf '%s\n' "$MACU" >>"$TMP"
done
seen(){ grep -Fxq "$(printf '%s' "$1" | tr 'a-f' 'A-F')" "$TMP" 2>/dev/null; }
[ -r /tmp/dhcp.leases ] && awk '{if(NF>=4&&$2!=""&&$4!=""&&$4!="*")printf "%s|%s\n",toupper($2),$4}' /tmp/dhcp.leases | while IFS='|' read -r MAC NAME; do seen "$MAC" && printf 'H|%s|%s\n' "$MAC" "$(printf '%s' "$NAME"|tr '|\r\n' '   ')"; done
for S in $(uci show dhcp 2>/dev/null|sed -n 's/^dhcp\.\([^.=]*\)=host$/\1/p'); do
  MAC="$(uci -q get dhcp.$S.mac || true)"; NAME="$(uci -q get dhcp.$S.name || true)"; IP="$(uci -q get dhcp.$S.ip || true)"
  [ -n "$MAC" ] || continue; valid_mac "$MAC" || continue; seen "$MAC" || continue
  MACU="$(printf '%s' "$MAC"|tr 'a-f' 'A-F')"
  [ -n "$NAME" ] && printf 'H|%s|%s\n' "$MACU" "$(printf '%s' "$NAME"|tr '|\r\n' '   ')"
  OWN=0; case "$S" in mrouter_reserve_*) OWN=1;; esac
  [ -n "$IP" ] && printf 'R|%s|%s|%s\n' "$MACU" "$IP" "$OWN"
done
if [ -x /usr/sbin/nlbw ]; then /usr/sbin/nlbw -c csv -g mac -o mac -s'|' -q 2>/dev/null | awk -F'|' 'NR>1&&NF>=6{gsub(/"/,"",$1);gsub(/"/,"",$3);gsub(/"/,"",$5);printf "B|%s|%s|%s\n",toupper($1),$3,$5}'; fi
if command -v iwinfo >/dev/null 2>&1; then
  for IF in $(iwinfo 2>/dev/null | awk '/ESSID:/{print $1}'); do
    iwinfo "$IF" assoclist 2>/dev/null | awk -v i="$IF" '/^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}[[:space:]]/{printf "W|%s|%s\n",toupper($1),i}'
  done
fi
for S in $(uci show firewall 2>/dev/null|sed -n 's/^firewall\.\([^.=]*\)=rule$/\1/p'); do NAME="$(uci -q get firewall.$S.name || true)"; case "$NAME" in "Mrouter block "*) MAC="$(uci -q get firewall.$S.src_mac || true)"; [ -n "$MAC" ] && seen "$MAC" && echo "X|$(printf '%s' "$MAC"|tr 'a-f' 'A-F')";; esac; done
