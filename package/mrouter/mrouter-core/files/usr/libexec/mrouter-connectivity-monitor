#!/bin/sh

STATE="/tmp/mrouter-connectivity.state"

LAST=""
SINCE="0"


check_internet() {

    ping -c 1 -W 1 1.1.1 \
        >/dev/null 2>&1 &&
        return 0

    ping -c 1 -W 1 8.8.8.8 \
        >/dev/null 2>&1 &&
        return 0

    # Some networks deliberately block ICMP. Confirm with a bounded HTTPS
    # request before declaring the Internet offline.
    curl -4 -fsS --connect-timeout 2 --max-time 4 \
        -o /dev/null https://connectivitycheck.gstatic.com/generate_204 \
        >/dev/null 2>&1 &&
        return 0

    curl -4 -fsS --connect-timeout 2 --max-time 4 \
        -o /dev/null https://detectportal.firefox.com/success.txt \
        >/dev/null 2>&1 &&
        return 0

    return 1
}


while :; do

    NOW="$(date +%s)"

    if check_internet; then
        CURRENT="online"
    else
        CURRENT="offline"
    fi


    if [ "$CURRENT" != "$LAST" ] ||
       [ "$SINCE" -le 0 ] 2>/dev/null; then

        SINCE="$NOW"
        LAST="$CURRENT"
    fi


    TMP="${STATE}.$$"

    {
        echo "status=$CURRENT"
        echo "since=$SINCE"
        echo "checked=$NOW"
    } > "$TMP"

    mv "$TMP" "$STATE"

    sleep 5
done
