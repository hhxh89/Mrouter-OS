#!/bin/sh
set -u
ACTION="${1:-status}"

valid_domain() {
    D="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
    [ -n "$D" ] || return 1
    [ "${#D}" -le 253 ] || return 1
    printf '%s\n' "$D" | grep -Eq '^[a-z0-9][a-z0-9.-]*[a-z0-9]$|^[a-z0-9]$'
}
valid_ipish() { [ -n "$1" ] && printf '%s\n' "$1" | grep -Eq '^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$'; }
clean_tokens() { printf '%s' "$1" | tr ',\r\n\t' '    ' | tr -s ' ' | sed 's/^ *//;s/ *$//'; }

remove_dns_domains() {
    for D in $1; do
        valid_domain "$D" || continue
        uci -q del_list "dhcp.@dnsmasq[0].address=/$D/#" || true
    done
}

is_allowed() {
    NEEDLE="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
    for A in $(uci -q get mrouterfilter.config.allow 2>/dev/null); do
        A="$(printf '%s' "$A" | tr 'A-Z' 'a-z')"
        [ "$A" = "$NEEDLE" ] && return 0
    done
    return 1
}

add_dns_domains() {
    for D in $1; do
        D="$(printf '%s' "$D" | tr 'A-Z' 'a-z')"
        valid_domain "$D" || continue
        is_allowed "$D" && continue
        uci -q del_list "dhcp.@dnsmasq[0].address=/$D/#" || true
        uci add_list "dhcp.@dnsmasq[0].address=/$D/#"
    done
}

sync_dns_security() {
    FORCE="$(uci -q get mrouterfilter.config.force_dns)"; [ "$FORCE" = 1 ] || FORCE=0
    DOT="$(uci -q get mrouterfilter.config.block_dot)"; [ "$DOT" = 1 ] || DOT=0
    if uci -q get https-dns-proxy.config >/dev/null 2>&1; then
        uci set "https-dns-proxy.config.force_dns=$FORCE"
        uci -q delete https-dns-proxy.config.force_dns_port
        uci -q delete https-dns-proxy.config.force_dns_src_interface
        if [ "$FORCE" = 1 ]; then
            uci add_list https-dns-proxy.config.force_dns_port='53'
            [ "$DOT" = 1 ] && uci add_list https-dns-proxy.config.force_dns_port='853'
            uci -q get network.lan >/dev/null 2>&1 && uci add_list https-dns-proxy.config.force_dns_src_interface='lan'
            uci -q get network.iot >/dev/null 2>&1 && uci add_list https-dns-proxy.config.force_dns_src_interface='iot'
        fi
        uci commit https-dns-proxy
        /etc/init.d/https-dns-proxy restart >/dev/null 2>&1 || true
    fi
}

sync_nft() {
    ENABLED="$(uci -q get mrouterfilter.config.enabled)"; [ "$ENABLED" = 1 ] || ENABLED=0
    nft delete table inet mrouter_content >/dev/null 2>&1 || true
    [ "$ENABLED" = 1 ] || return 0
    nft -f - <<'NFT'
table inet mrouter_content {
    set blocked_v4 { type ipv4_addr; flags interval; }
    set blocked_v6 { type ipv6_addr; flags interval; }
    chain forward {
        type filter hook forward priority -4; policy accept;
        ip daddr @blocked_v4 counter drop
        ip6 daddr @blocked_v6 counter drop
    }
}
NFT
    for I in $(uci -q get mrouterfilter.config.ip 2>/dev/null); do
        valid_ipish "$I" || continue
        case "$I" in *:*) nft add element inet mrouter_content blocked_v6 "{ $I }" >/dev/null 2>&1 || true ;; *) nft add element inet mrouter_content blocked_v4 "{ $I }" >/dev/null 2>&1 || true ;; esac
    done
}

apply_all() {
    ENABLED="$(uci -q get mrouterfilter.config.enabled)"; [ "$ENABLED" = 1 ] || ENABLED=0
    DOMAINS="$(uci -q get mrouterfilter.config.domain 2>/dev/null)"
    remove_dns_domains "$DOMAINS"
    [ "$ENABLED" = 1 ] && add_dns_domains "$DOMAINS"
    uci commit dhcp
    /etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
    sync_dns_security
    sync_nft
}

status() {
    E="$(uci -q get mrouterfilter.config.enabled)"; [ "$E" = 1 ] || E=0
    F="$(uci -q get mrouterfilter.config.force_dns)"; [ "$F" = 1 ] || F=0
    D="$(uci -q get mrouterfilter.config.block_dot)"; [ "$D" = 1 ] || D=0
    DC=0; IC=0; AC=0
    for X in $(uci -q get mrouterfilter.config.domain 2>/dev/null); do DC=$((DC+1)); done
    for X in $(uci -q get mrouterfilter.config.ip 2>/dev/null); do IC=$((IC+1)); done
    for X in $(uci -q get mrouterfilter.config.allow 2>/dev/null); do AC=$((AC+1)); done
    printf 'STATUS|%s|%s|%s|%s|%s|%s\n' "$E" "$F" "$D" "$DC" "$IC" "$AC"
    for X in $(uci -q get mrouterfilter.config.domain 2>/dev/null); do printf 'DOMAIN|%s\n' "$X"; done
    for X in $(uci -q get mrouterfilter.config.allow 2>/dev/null); do printf 'ALLOW|%s\n' "$X"; done
    for X in $(uci -q get mrouterfilter.config.ip 2>/dev/null); do printf 'IP|%s\n' "$X"; done
}

save() {
    E="${2:-1}"; [ "$E" = 1 ] || E=0
    F="${3:-1}"; [ "$F" = 1 ] || F=0
    DOT="${4:-1}"; [ "$DOT" = 1 ] || DOT=0
    NEWDOM="$(clean_tokens "${5:-}")"
    NEWIP="$(clean_tokens "${6:-}")"
    NEWALLOW="$(clean_tokens "${7:-}")"
    OLDDOM="$(uci -q get mrouterfilter.config.domain 2>/dev/null)"
    remove_dns_domains "$OLDDOM"
    uci -q delete mrouterfilter.config.domain
    uci -q delete mrouterfilter.config.allow
    uci -q delete mrouterfilter.config.ip
    uci set "mrouterfilter.config.enabled=$E"
    uci set "mrouterfilter.config.force_dns=$F"
    uci set "mrouterfilter.config.block_dot=$DOT"
    for X in $NEWDOM; do X="$(printf '%s' "$X" | tr 'A-Z' 'a-z')"; valid_domain "$X" && uci add_list "mrouterfilter.config.domain=$X"; done
    for X in $NEWALLOW; do X="$(printf '%s' "$X" | tr 'A-Z' 'a-z')"; valid_domain "$X" && uci add_list "mrouterfilter.config.allow=$X"; done
    for X in $NEWIP; do valid_ipish "$X" && uci add_list "mrouterfilter.config.ip=$X"; done
    uci commit mrouterfilter
    apply_all
    status
}

case "$ACTION" in
    status) status ;;
    apply) apply_all; status ;;
    enable) V="${2:-1}"; [ "$V" = 1 ] || V=0; uci set "mrouterfilter.config.enabled=$V"; uci commit mrouterfilter; apply_all; status ;;
    save) save "$@" ;;
    *) echo 'Usage: mrouter-content-filter {status|apply|enable 0|1|save enabled force_dns block_dot domains ips allow_domains}' >&2; exit 2 ;;
esac
