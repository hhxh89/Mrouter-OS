#!/bin/sh
set -u
ACTION="${1:-status}"
esc(){ printf '%s' "${1:-}" | tr '|\r\n' '   '; }
safe(){ printf '%s\n' "${1:-}" | grep -Eq '^[A-Za-z][A-Za-z0-9_]{0,14}$'; }
status(){ for S in $(uci show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do [ "$S" = loopback ] && continue; P="$(uci -q get network.$S.proto || true)"; D="$(uci -q get network.$S.device || uci -q get network.$S.ifname || true)"; IP="$(uci -q get network.$S.ipaddr || true)"; MASK="$(uci -q get network.$S.netmask || true)"; MAN="$(uci -q get network.$S.mrouter_managed || echo 0)"; UP=0; ubus call network.interface.$S status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null | grep -q true && UP=1 || true; ZONE=""; for Z in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do case " $(uci -q get firewall.$Z.network 2>/dev/null) " in *" $S "*) ZONE="$(uci -q get firewall.$Z.name || echo "$Z")"; break;; esac; done; printf 'NET|%s|%s|%s|%s|%s|%s|%s|%s\n' "$S" "$(esc "$P")" "$(esc "$D")" "$(esc "$IP")" "$(esc "$MASK")" "$UP" "$(esc "$ZONE")" "$MAN"; done; }
backup(){ TS="$(date +%Y%m%d-%H%M%S)"; DIR="/tmp/mrouter-network-backup-$TS"; mkdir -p "$DIR" || exit 1; uci export network > "$DIR/network.uci"; uci export dhcp > "$DIR/dhcp.uci"; uci export firewall > "$DIR/firewall.uci"; tar -czf "$DIR.tar.gz" -C /tmp "$(basename "$DIR")" 2>/dev/null || true; echo "$DIR.tar.gz"; }
create_net(){ ID="${2:-}"; TYPE="${3:-custom}"; CIDR="${4:-}"; VLAN="${5:-0}"; PARENT="${6:-}"; DHCP="${7:-1}"; INTERNET="${8:-1}"; safe "$ID" || { echo 'Invalid network name' >&2; exit 1; }; [ -z "$(uci -q get network.$ID)" ] || { echo 'Network already exists' >&2; exit 1; }; for Z0 in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do [ "$(uci -q get firewall.$Z0.name)" = "$ID" ] && { echo 'A firewall zone with that name already exists' >&2; exit 1; }; done; case "$DHCP:$INTERNET" in 0:0|0:1|1:0|1:1) ;; *) exit 1;; esac; case "$TYPE" in lan|guest|iot|custom) ;; *) exit 1;; esac; case "$CIDR" in */*) ;; *) echo 'Use router-address/prefix' >&2; exit 1;; esac; IP="${CIDR%/*}"; BITS="${CIDR#*/}"; printf '%s' "$IP" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || exit 1; case "$BITS" in ''|*[!0-9]*) exit 1;; esac; [ "$BITS" -ge 8 ] && [ "$BITS" -le 30 ] || exit 1; MASK="$(ipcalc.sh "$IP" "$BITS" 2>/dev/null | sed -n 's/^NETMASK=//p' | head -n1)"; [ -n "$MASK" ] || exit 1; BACKUP="$(backup)"; uci set network.$ID='interface'; uci set network.$ID.proto='static'; uci set network.$ID.ipaddr="$IP"; uci set network.$ID.netmask="$MASK"; uci set network.$ID.mrouter_managed='1'; uci set network.$ID.mrouter_type="$TYPE"; if [ "$VLAN" != 0 ]; then case "$VLAN" in *[!0-9]*) exit 1;; esac; [ "$VLAN" -ge 1 ] && [ "$VLAN" -le 4094 ] || exit 1; [ -n "$PARENT" ] || exit 1; uci set network.$ID.device="$PARENT.$VLAN"; fi; uci set dhcp.$ID='dhcp'; uci set dhcp.$ID.interface="$ID"; uci set dhcp.$ID.ignore="$([ "$DHCP" = 1 ] && echo 0 || echo 1)"; uci set dhcp.$ID.start='100'; uci set dhcp.$ID.limit='100'; uci set dhcp.$ID.leasetime='12h'; uci set dhcp.$ID.mrouter_managed='1'; Z="mrouter_$ID"; uci set firewall.$Z='zone'; uci set firewall.$Z.name="$ID"; uci add_list firewall.$Z.network="$ID"; uci set firewall.$Z.output='ACCEPT'; uci set firewall.$Z.forward='REJECT'; uci set firewall.$Z.mrouter_managed='1'; if [ "$TYPE" = lan ]; then uci set firewall.$Z.input='ACCEPT'; else uci set firewall.$Z.input='REJECT'; RD="mrouter_${ID}_dhcp"; uci set firewall.$RD='rule'; uci set firewall.$RD.name="Mrouter $ID DHCP"; uci set firewall.$RD.src="$ID"; uci set firewall.$RD.proto='udp'; uci set firewall.$RD.dest_port='67-68'; uci set firewall.$RD.target='ACCEPT'; uci set firewall.$RD.mrouter_managed='1'; RN="mrouter_${ID}_dns"; uci set firewall.$RN='rule'; uci set firewall.$RN.name="Mrouter $ID DNS"; uci set firewall.$RN.src="$ID"; uci set firewall.$RN.proto='tcp udp'; uci set firewall.$RN.dest_port='53'; uci set firewall.$RN.target='ACCEPT'; uci set firewall.$RN.mrouter_managed='1'; fi; if [ "$INTERNET" = 1 ]; then F="mrouter_${ID}_wan"; uci set firewall.$F='forwarding'; uci set firewall.$F.src="$ID"; uci set firewall.$F.dest='wan'; uci set firewall.$F.mrouter_managed='1'; fi; uci commit network; uci commit dhcp; uci commit firewall; /etc/init.d/network reload >/dev/null 2>&1 || true; /etc/init.d/firewall reload >/dev/null 2>&1 || true; /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true; printf 'BACKUP|%s\n' "$BACKUP"; status; }
delete_net(){ ID="${2:-}"; safe "$ID" || exit 1; [ "$(uci -q get network.$ID.mrouter_managed)" = 1 ] || { echo 'Only Mrouter-created networks can be deleted' >&2; exit 1; }; backup >/dev/null; uci -q delete network.$ID; uci -q delete dhcp.$ID; for S in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=\(zone\|rule\|forwarding\)$/\1/p'); do [ "$(uci -q get firewall.$S.mrouter_managed)" = 1 ] || continue; case "$S" in mrouter_${ID}|mrouter_${ID}_*) uci -q delete firewall.$S;; esac; done; uci commit network; uci commit dhcp; uci commit firewall; /etc/init.d/network reload >/dev/null 2>&1 || true; /etc/init.d/firewall reload >/dev/null 2>&1 || true; /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true; status; }
case "$ACTION" in status) status;; create) create_net "$@";; delete) delete_net "$@";; backup) backup;; *) exit 2;; esac
