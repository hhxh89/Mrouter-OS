#!/bin/sh
set -u
target_up(){ T="$1"; [ -n "$T" ] || return 1; if [ "$T" = wan ]; then U="$(ubus call network.interface.wan status 2>/dev/null)"; [ "$(printf '%s' "$U"|jsonfilter -e '@.up' 2>/dev/null)" = true ]; return; fi; case "$T" in @*) D="${T#@}"; [ -e "/sys/class/net/$D/operstate" ] || return 1; S="$(cat "/sys/class/net/$D/operstate" 2>/dev/null)"; [ "$S" = up ] || [ "$S" = unknown ]; return;; esac; if [ -e "/sys/class/net/$T/operstate" ]; then S="$(cat "/sys/class/net/$T/operstate" 2>/dev/null)"; [ "$S" = up ] || [ "$S" = unknown ]; return; fi; U="$(ubus call network.interface.$T status 2>/dev/null)"; [ "$(printf '%s' "$U"|jsonfilter -e '@.up' 2>/dev/null)" = true ]; }
day_allowed(){ MODE="$1"; DAYS="$2"; D="$3"; case "$MODE" in always) return 0;; weekdays) [ "$D" -le 5 ];; weekends) [ "$D" -ge 6 ];; custom) case ",$DAYS," in *",$D,"*) return 0;; *) return 1;; esac;; *) return 0;; esac; }
schedule_active(){ MODE="${1:-always}"; DAYS="${2:-}"; START="${3:-00:00}"; END="${4:-23:59}"; [ "$MODE" = always ] && return 0; DOW="$(date +%u)"; HM="$(date +%H%M)"; S="$(printf '%s' "$START"|tr -d ':')"; E="$(printf '%s' "$END"|tr -d ':')"; case "$S$E" in ''|*[!0-9]*) return 0;; esac; [ "$S" = "$E" ] && { day_allowed "$MODE" "$DAYS" "$DOW"; return; }; if [ "$S" -lt "$E" ]; then day_allowed "$MODE" "$DAYS" "$DOW" || return 1; [ "$HM" -ge "$S" ] && [ "$HM" -lt "$E" ]; return; fi; if [ "$HM" -ge "$S" ]; then day_allowed "$MODE" "$DAYS" "$DOW"; return; fi; if [ "$HM" -lt "$E" ]; then PREV=$((DOW-1)); [ "$PREV" -lt 1 ] && PREV=7; day_allowed "$MODE" "$DAYS" "$PREV"; return; fi; return 1; }
setp(){ S="$1"; K="$2"; V="$3"; C="$(uci -q get pbr.$S.$K)"; [ "$C" = "$V" ] && return; uci set "pbr.$S.$K=$V"; PBR_CHANGED=1; }
setm(){ S="$1"; K="$2"; V="$3"; C="$(uci -q get mrouterpolicy.$S.$K)"; [ "$C" = "$V" ] && return; uci set "mrouterpolicy.$S.$K=$V"; META_CHANGED=1; }
event_transition(){ S="$1"; OLD="$2"; NEW="$3"; NAME="$(uci -q get pbr.$S.name || echo "$S")"; [ "$OLD" = "$NEW" ] && return; [ -x /usr/libexec/mrouter-events ] || return; case "$NEW" in blocked) LV=critical;; wan_fallback|vpn_fallback) LV=warning;; *) LV=info;; esac; /usr/libexec/mrouter-events add "$LV" vpn "Policy $NAME: ${OLD:-unknown} → $NEW" >/dev/null 2>&1 || true; }
while :; do if [ "$(uci -q get pbr.config.enabled)" != 1 ]; then sleep 15; continue; fi; PBR_CHANGED=0; META_CHANGED=0; MANAGED=0; for SEC in $(uci show mrouterpolicy 2>/dev/null | sed -n 's/^mrouterpolicy\.\([^.=]*\)=policy$/\1/p'); do [ "$(uci -q get pbr.$SEC)" = policy ] || continue; MANAGED=$((MANAGED+1)); DESIRED="$(uci -q get mrouterpolicy.$SEC.desired_target)"; [ -n "$DESIRED" ] || DESIRED="$(uci -q get pbr.$SEC.interface)"; FAIL="$(uci -q get mrouterpolicy.$SEC.fail_mode)"; case "$FAIL" in block|wan|other) ;; *) FAIL=block;; esac; FALLBACK="$(uci -q get mrouterpolicy.$SEC.fallback_target)"; MODE="$(uci -q get mrouterpolicy.$SEC.schedule_mode)"; [ -n "$MODE" ] || MODE=always; DAYS="$(uci -q get mrouterpolicy.$SEC.schedule_days)"; START="$(uci -q get mrouterpolicy.$SEC.schedule_start)"; [ -n "$START" ] || START=00:00; END="$(uci -q get mrouterpolicy.$SEC.schedule_end)"; [ -n "$END" ] || END=23:59; USER="$(uci -q get mrouterpolicy.$SEC.user_enabled)"; [ "$USER" = 0 ] || USER=1; EX="$(uci -q get mrouterpolicy.$SEC.exclude_section)"; OLDSTATE="$(uci -q get mrouterpolicy.$SEC.runtime_state)"; if [ "$USER" != 1 ]; then WANT=0; STATE=disabled; ACTUAL="$DESIRED"; elif schedule_active "$MODE" "$DAYS" "$START" "$END"; then WANT=1; STATE=active; ACTUAL="$DESIRED"; else WANT=0; STATE=scheduled; ACTUAL="$DESIRED"; fi; setp "$SEC" enabled "$WANT"; [ -n "$EX" ] && [ "$(uci -q get pbr.$EX)" = policy ] && setp "$EX" enabled "$WANT"; if [ "$WANT" = 1 ]; then if target_up "$DESIRED"; then STATE=active; ACTUAL="$DESIRED"; else case "$FAIL" in wan) STATE=wan_fallback; ACTUAL=wan;; other) if [ -n "$FALLBACK" ] && target_up "$FALLBACK"; then STATE=vpn_fallback; ACTUAL="$FALLBACK"; else STATE=blocked; ACTUAL="$DESIRED"; fi;; *) STATE=blocked; ACTUAL="$DESIRED";; esac; fi; setp "$SEC" interface "$ACTUAL"; fi; setm "$SEC" runtime_state "$STATE"; setm "$SEC" runtime_target "$ACTUAL"; event_transition "$SEC" "$OLDSTATE" "$STATE"; done; if [ "$MANAGED" -gt 0 ] && [ "$(uci -q get pbr.config.strict_enforcement)" != 1 ]; then uci set pbr.config.strict_enforcement='1'; PBR_CHANGED=1; fi; [ "$META_CHANGED" = 1 ] && uci commit mrouterpolicy; if [ "$PBR_CHANGED" = 1 ]; then uci commit pbr; /etc/init.d/pbr restart >/dev/null 2>&1 || true; fi; sleep 15; done
