#!/bin/sh
set -eu
SERVICE="${1:-}"; ACTION="${2:-status}"
[ -n "$SERVICE" ] || { echo 'ERROR|Missing service'; exit 2; }
shift || true
shift || true
case "$SERVICE" in
  internet) H=/usr/libexec/mrouter-internet-info ;;
  traffic) H=/usr/libexec/mrouter-traffic-live ;;
  client-data) H=/usr/libexec/mrouter-client-data ;;
  iot-info) H=/usr/libexec/mrouter-iot-info ;;
  clients) H=/usr/libexec/mrouter-clients ;;
  client-action) H=/usr/libexec/mrouter-client-action ;;
  wireless) H=/usr/libexec/mrouter-wireless ;;
  networks) H=/usr/libexec/mrouter-networks ;;
  events) H=/usr/libexec/mrouter-events ;;
  wan) H=/usr/libexec/mrouter-wan ;;
  dhcp) H=/usr/libexec/mrouter-dhcp ;;
  firewall) H=/usr/libexec/mrouter-firewall ;;
  support) H=/usr/libexec/mrouter-support ;;
  adguard) H=/usr/libexec/mrouter-adguard ;;
  status-adguard) H=/usr/libexec/mrouter-status-adguard ;;
  tailscale) H=/usr/libexec/mrouter-tailscale ;;
  status-tailscale) H=/usr/libexec/mrouter-status-tailscale ;;
  wireguard) H=/usr/libexec/mrouter-wireguard ;;
  status-wireguard) H=/usr/libexec/mrouter-status-wireguard ;;
  wireguard-client) H=/usr/libexec/mrouter-wireguard-client ;;
  status-wireguard-client) H=/usr/libexec/mrouter-status-wireguard-client ;;
  openvpn) H=/usr/libexec/mrouter-openvpn ;;
  status-openvpn) H=/usr/libexec/mrouter-status-openvpn ;;
  policy) H=/usr/libexec/mrouter-policy ;;
  status-policy) H=/usr/libexec/mrouter-status-policy ;;
  ddns) H=/usr/libexec/mrouter-ddns ;;
  status-ddns) H=/usr/libexec/mrouter-status-ddns ;;
  ports) H=/usr/libexec/mrouter-ports ;;
  status-ports) H=/usr/libexec/mrouter-status-ports ;;
  parental) H=/usr/libexec/mrouter-parental ;;
  status-parental) H=/usr/libexec/mrouter-status-parental ;;
  content-filter) H=/usr/libexec/mrouter-content-filter ;;
  status-content-filter) H=/usr/libexec/mrouter-status-content-filter ;;
  status-health) H=/usr/libexec/mrouter-status-health ;;
  services) H=/usr/libexec/mrouter-services ;;
  advanced) H=/usr/libexec/mrouter-advanced ;;
  ui-config) H=/usr/libexec/mrouter-ui-config ;;
  *) echo 'ERROR|Unknown service'; exit 2 ;;
esac
[ -x "$H" ] || { echo "ERROR|Service unavailable: $SERVICE"; exit 127; }
case "$ACTION" in *[!A-Za-z0-9_.:-]*|'') echo 'ERROR|Invalid action'; exit 2;; esac

case "$SERVICE:$ACTION" in
  internet:refresh|internet:status|traffic:status|client-data:snapshot|client-data:snapshot-iot|iot-info:status|\
  clients:status|clients:alias|clients:quarantine|clients:group-save|clients:group-delete|client-action:block|client-action:reserve|\
  wireless:status|wireless:add-ssid|wireless:radio-save|wireless:ssid-save|wireless:delete-ssid|\
  networks:status|networks:create|networks:delete|networks:backup|events:status|events:settings|events:clear|\
  wan:status|wan:history|wan:save|wan:disable|wan:sample|dhcp:status|dhcp:scope-save|dhcp:add-reservation|dhcp:delete-reservation|\
  firewall:status|firewall:add-forward|firewall:delete-forward|firewall:upnp|support:status|support:refresh|support:bundle|\
  adguard:status|adguard:start|adguard:stop|adguard:restart|status-adguard:status|\
  tailscale:status|tailscale:up|tailscale:down|tailscale:bind|tailscale:disable|tailscale:finalize|tailscale:apply|status-tailscale:status|\
  wireguard:status|wireguard:generate|wireguard:view|wireguard:revoke|wireguard:restart|status-wireguard:status|\
  wireguard-client:status|wireguard-client:import|wireguard-client:connect|wireguard-client:disconnect|wireguard-client:delete|wireguard-client:rename|status-wireguard-client:status|\
  openvpn:status|openvpn:import|openvpn:select|openvpn:connect|openvpn:disconnect|openvpn:credentials|openvpn:remove|status-openvpn:status|\
  policy:status|policy:reconcile|policy:service|policy:add|policy:delete|policy:toggle|policy:move|policy:group-add|policy:group-delete|policy:test|status-policy:status|\
  ddns:status|ddns:add|ddns:toggle|ddns:force|ddns:delete|status-ddns:status|\
  ports:status|ports:set|ports:swap|ports:clear-pending|status-ports:status|\
  parental:status|parental:apply|parental:enable|parental:save|parental:pause|parental:delete|status-parental:status|\
  content-filter:status|content-filter:apply|content-filter:enable|content-filter:save|status-content-filter:status|\
  status-health:status|services:status|services:add|services:delete|services:test|services:dns-pihole|services:dns-mrouter|\
  advanced:snapshot|advanced:sqm-save|advanced:system-save|advanced:ssh-save|advanced:service-action|advanced:diagnostics|advanced:logs|advanced:processes|advanced:packages|advanced:keys|\
  advanced:password-set|advanced:key-add|advanced:key-delete|advanced:web-save|advanced:route-add|advanced:route-delete|advanced:pkg-refresh|advanced:pkg-install|advanced:pkg-remove|advanced:pkg-upgrade|advanced:backup-create|\
  ui-config:status|ui-config:set|ui-config:export|ui-config:apply|ui-config:reset) ;;
  *) echo "ERROR|Action not allowed: $SERVICE:$ACTION"; exit 3 ;;
esac

case "$SERVICE:$ACTION" in
  tailscale:up) ACTION=bind ;;
  tailscale:down) ACTION=disable ;;
  adguard:start|adguard:restart) ACTION=enable ;;
  adguard:stop) ACTION=disable ;;
  openvpn:connect) set -- 1 "$@"; ACTION=connect ;;
  openvpn:disconnect) set -- 0 "$@"; ACTION=connect ;;
  policy:reconcile) ACTION=status ;;
esac

exec "$H" "$ACTION" "$@"
