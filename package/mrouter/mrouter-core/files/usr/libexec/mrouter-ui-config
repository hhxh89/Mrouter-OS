#!/bin/sh
set -eu
CFG=mrouterui
SEC=appearance
ROOT=/etc/mrouter/ui.d
DEFAULT=/usr/share/mrouter/ui/defaults
WEB=/www/luci-static/mrouter-ui
AP_YAML=$ROOT/appearance.yaml
AP_JSON=$WEB/user-config.json
ensure(){ uci -q get "$CFG.$SEC" >/dev/null 2>&1 || { uci set "$CFG.$SEC=ui"; uci set "$CFG.$SEC.accent=#007AFF"; uci set "$CFG.$SEC.density=compact"; uci set "$CFG.$SEC.sidebar_width=212"; uci set "$CFG.$SEC.content_max_width=1440"; uci set "$CFG.$SEC.form_max_width=360"; uci set "$CFG.$SEC.card_radius=14"; uci set "$CFG.$SEC.compact_forms=1"; uci commit "$CFG"; }; mkdir -p "$ROOT" "$WEB"; }
valid_hex(){ echo "$1" | grep -Eq '^#[0-9A-Fa-f]{6}$'; }
valid_int(){ case "$1" in ''|*[!0-9]*) return 1;; esac; [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
write_appearance(){ accent="$(uci -q get $CFG.$SEC.accent || echo '#007AFF')"; density="$(uci -q get $CFG.$SEC.density || echo compact)"; sidebar="$(uci -q get $CFG.$SEC.sidebar_width || echo 212)"; content="$(uci -q get $CFG.$SEC.content_max_width || echo 1440)"; form="$(uci -q get $CFG.$SEC.form_max_width || echo 360)"; radius="$(uci -q get $CFG.$SEC.card_radius || echo 14)"; compact="$(uci -q get $CFG.$SEC.compact_forms || echo 1)"; cat >"$AP_YAML" <<EOF
version: 1
appearance:
  accent: "$accent"
  density: $density
  sidebar_width: $sidebar
  content_max_width: $content
  form_max_width: $form
  card_radius: $radius
  compact_forms: $([ "$compact" = 1 ] && echo true || echo false)
EOF
cat >"$AP_JSON" <<EOF
{"version":1,"appearance":{"accent":"$accent","density":"$density","sidebar_width":$sidebar,"content_max_width":$content,"form_max_width":$form,"card_radius":$radius,"compact_forms":$([ "$compact" = 1 ] && echo true || echo false)}}
EOF
}
status(){ ensure; write_appearance; printf 'STATUS|%s|%s|%s|%s|%s|%s|%s\n' "$(uci -q get $CFG.$SEC.accent)" "$(uci -q get $CFG.$SEC.density)" "$(uci -q get $CFG.$SEC.sidebar_width)" "$(uci -q get $CFG.$SEC.content_max_width)" "$(uci -q get $CFG.$SEC.form_max_width)" "$(uci -q get $CFG.$SEC.card_radius)" "$(uci -q get $CFG.$SEC.compact_forms)"; }
set_values(){ ensure; accent="$1"; density="$2"; sidebar="$3"; content="$4"; form="$5"; radius="$6"; compact="$7"; valid_hex "$accent" || { echo 'ERROR|Invalid accent colour'; exit 2; }; case "$density" in compact|comfortable) ;; *) echo 'ERROR|Invalid density'; exit 2;; esac; valid_int "$sidebar" 180 320 || { echo 'ERROR|Sidebar width must be 180-320'; exit 2; }; valid_int "$content" 900 2200 || { echo 'ERROR|Content width must be 900-2200'; exit 2; }; valid_int "$form" 220 640 || { echo 'ERROR|Form width must be 220-640'; exit 2; }; valid_int "$radius" 0 28 || { echo 'ERROR|Card radius must be 0-28'; exit 2; }; case "$compact" in 0|1) ;; *) echo 'ERROR|Invalid compact_forms'; exit 2;; esac; uci set "$CFG.$SEC.accent=$accent"; uci set "$CFG.$SEC.density=$density"; uci set "$CFG.$SEC.sidebar_width=$sidebar"; uci set "$CFG.$SEC.content_max_width=$content"; uci set "$CFG.$SEC.form_max_width=$form"; uci set "$CFG.$SEC.card_radius=$radius"; uci set "$CFG.$SEC.compact_forms=$compact"; uci commit "$CFG"; write_appearance; echo 'OK|saved'; }
kind_ok(){ case "$1" in pages|navigation|login) return 0;; *) return 1;; esac; }
json_version(){ jsonfilter -i "$1" -e '@.version' 2>/dev/null || true; }
validate_pages(){
    if grep -Eq '"type"[[:space:]]*:[[:space:]]*"legacy"|"component"[[:space:]]*:|"javascript"[[:space:]]*:|"shell"[[:space:]]*:|"command"[[:space:]]*:' "$1"; then
        echo 'ERROR|Pages may use only native Mrouter YAML blocks and registered service actions'
        return 7
    fi
    grep -o '"service"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" 2>/dev/null | sed 's/.*"service"[[:space:]]*:[[:space:]]*"\([^"]*\)"/\1/' | while read -r s; do
        case "$s" in internet|internet-summary|traffic|client-data|iot-info|clients|client-action|wireless|networks|events|wan|dhcp|firewall|support|adguard|status-adguard|tailscale|status-tailscale|wireguard|status-wireguard|wireguard-client|status-wireguard-client|openvpn|status-openvpn|policy|status-policy|ddns|status-ddns|ports|status-ports|parental|status-parental|content-filter|status-content-filter|status-health|services|terminal|account|advanced|ui-config|upload) :;; *) echo "ERROR|Unregistered service: $s"; exit 7;; esac
    done
}
validate_navigation(){ grep -o '"href"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" 2>/dev/null | sed 's/.*"href"[[:space:]]*:[[:space:]]*"\([^"]*\)"/\1/' | while read -r h; do case "$h" in /cgi-bin/luci/*) :;; *) echo "ERROR|Unsafe navigation href: $h"; exit 8;; esac; done; }
validate_doc_file(){ kind="$1"; j="$2"; [ "$(json_version "$j")" = 1 ] || { echo 'ERROR|Document version must be 1'; return 2; }; case "$kind" in pages) validate_pages "$j";; navigation) validate_navigation "$j";; login) :;; esac; }
apply_doc(){ kind="$1"; kind_ok "$kind" || { echo 'ERROR|Unknown document'; exit 2; }; y="/tmp/mrouter-ui-$kind.yaml"; j="/tmp/mrouter-ui-$kind.json"; [ -s "$y" ] && [ -s "$j" ] || { echo 'ERROR|Editor staging files missing'; exit 2; }; validate_doc_file "$kind" "$j" || exit $?; ensure; umask 077; [ -s "$ROOT/$kind.yaml" ] && cp "$ROOT/$kind.yaml" "$ROOT/.last-good-$kind.yaml" || true; [ -s "$ROOT/$kind.json" ] && cp "$ROOT/$kind.json" "$ROOT/.last-good-$kind.json" || true; cp "$y" "$ROOT/.$kind.yaml.new"; cp "$j" "$ROOT/.$kind.json.new"; mv "$ROOT/.$kind.yaml.new" "$ROOT/$kind.yaml"; mv "$ROOT/.$kind.json.new" "$ROOT/$kind.json"; cp "$j" "$WEB/.user-$kind.json.new"; chmod 0644 "$WEB/.user-$kind.json.new"; mv "$WEB/.user-$kind.json.new" "$WEB/user-$kind.json"; chmod 0644 "$ROOT/$kind.yaml" "$ROOT/$kind.json"; rm -f "$y" "$j"; echo "OK|$kind applied"; }
export_doc(){ kind="$1"; kind_ok "$kind" || { echo 'ERROR|Unknown document'; exit 2; }; ensure; if [ -s "$ROOT/$kind.yaml" ]; then cat "$ROOT/$kind.yaml"; elif [ -s "$DEFAULT/$kind.yaml" ]; then cat "$DEFAULT/$kind.yaml"; else echo 'ERROR|Default YAML missing'; exit 2; fi; }
save_text(){ kind="$1"; yaml="$2"; json="$3"; kind_ok "$kind" || { echo 'ERROR|Unknown document'; exit 2; }; [ -n "$yaml" ] && [ -n "$json" ] || { echo 'ERROR|YAML and compiled JSON are required'; exit 2; }; ensure; umask 077; y="/tmp/mrouter-ui-$kind.yaml"; j="/tmp/mrouter-ui-$kind.json"; printf '%s\n' "$yaml" >"$y"; printf '%s\n' "$json" >"$j"; validate_doc_file "$kind" "$j" || { rc=$?; rm -f "$y" "$j"; exit "$rc"; }; apply_doc "$kind"; }
validate_text(){ kind="$1"; json="$2"; kind_ok "$kind" || { echo 'ERROR|Unknown document'; exit 2; }; ensure; umask 077; j="/tmp/mrouter-ui-validate-$kind.json"; printf '%s\n' "$json" >"$j"; if validate_doc_file "$kind" "$j"; then rm -f "$j"; echo "OK|$kind valid"; return 0; else rc=$?; rm -f "$j"; return "$rc"; fi; }
reset_doc(){ kind="$1"; kind_ok "$kind" || { echo 'ERROR|Unknown document'; exit 2; }; rm -f "$ROOT/$kind.yaml" "$ROOT/$kind.json" "$WEB/user-$kind.json" "/tmp/mrouter-ui-$kind.yaml" "/tmp/mrouter-ui-$kind.json"; echo "OK|$kind reset"; }
reset_appearance(){ uci -q delete "$CFG.$SEC" || true; uci commit "$CFG" 2>/dev/null || true; rm -f "$AP_YAML" "$AP_JSON"; ensure; write_appearance; echo 'OK|reset'; }
cmd="${1:-status}"
case "$cmd" in
 status) status ;;
 set) shift; [ "$#" -eq 7 ] || { echo 'ERROR|Expected 7 values'; exit 2; }; set_values "$@" ;;
 export) [ "$#" -eq 2 ] || { echo 'ERROR|Expected document name'; exit 2; }; export_doc "$2" ;;
 apply) [ "$#" -eq 2 ] || { echo 'ERROR|Expected document name'; exit 2; }; ensure; apply_doc "$2" ;;
 save) [ "$#" -eq 4 ] || { echo 'ERROR|Expected kind, YAML and JSON'; exit 2; }; save_text "$2" "$3" "$4" ;;
 validate) [ "$#" -eq 3 ] || { echo 'ERROR|Expected kind and JSON'; exit 2; }; validate_text "$2" "$3" ;;
 reset) if [ "$#" -eq 1 ]; then reset_appearance; else reset_doc "$2"; fi ;;
 *) echo 'ERROR|Unknown command'; exit 2 ;;
esac
