#!/bin/sh
set -u
ACTION="${1:-status}"
CFG=mrouterwan
HIST=/tmp/mrouter-wan-quality.csv
esc(){ printf '%s' "${1:-}" | tr '|\r\n' '   '; }
safe(){ printf '%s\n' "${1:-}" | grep -Eq '^[A-Za-z0-9_]+$'; }
iface_up(){ ubus call network.interface."$1" status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null | grep -q true; }
status(){ EN="$(uci -q get $CFG.main.enabled || echo 0)"; PRI="$(uci -q get $CFG.main.primary || echo wan)"; SEC="$(uci -q get $CFG.main.secondary || true)"; MODE="$(uci -q get $CFG.main.mode || echo failover)"; printf 'STATUS|%s|%s|%s|%s\n' "$EN" "$PRI" "$SEC" "$MODE"; for I in $(uci show network 2>/dev/null | sed -n 's/^network\.\([^.=]*\)=interface$/\1/p'); do [ "$I" = loopback ] && continue; P="$(uci -q get network.$I.proto || true)"; D="$(uci -q get network.$I.device || uci -q get network.$I.ifname || true)"; IP="$(ubus call network.interface.$I status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"; GW="$(ubus call network.interface.$I status 2>/dev/null | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)"; MET="$(uci -q get network.$I.metric || true)"; UP=0; iface_up "$I" && UP=1 || true; printf 'WAN|%s|%s|%s|%s|%s|%s|%s\n' "$I" "$UP" "$(esc "$P")" "$(esc "$D")" "$(esc "$IP")" "$(esc "$GW")" "$(esc "$MET")"; done; PIF="$(uci -q get $CFG.main.primary || echo wan)"; PJSON="$(ubus call network.interface.$PIF status 2>/dev/null || true)"; IP6="$(printf '%s' "$PJSON" | jsonfilter -e '@["ipv6-address"][0].address' 2>/dev/null)"; GW6="$(ip -6 route show default 2>/dev/null | awk 'NR==1{for(i=1;i<=NF;i++)if($i=="via"){print $(i+1);exit}}')"; printf 'IPV6|%s|%s|%s\n' "$PIF" "$(esc "$IP6")" "$(esc "$GW6")"; W4="$(printf '%s' "$PJSON" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"; PUB="$(cat /tmp/mrouter-public-ip 2>/dev/null || true)"; CG=0; if [ -n "$W4" ] && [ -n "$PUB" ] && [ "$W4" != "$PUB" ]; then O1="${W4%%.*}"; REST="${W4#*.}"; O2="${REST%%.*}"; case "$W4" in 10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) CG=1;; esac; [ "$O1" = 100 ] && [ "$O2" -ge 64 ] 2>/dev/null && [ "$O2" -le 127 ] 2>/dev/null && CG=1 || true; fi; printf 'NAT|%s|%s|%s\n' "$(esc "$W4")" "$(esc "$PUB")" "$CG"; [ -r "$HIST" ] && tail -n 180 "$HIST" | while IFS='|' read -r E I LOSS AVG MAX; do printf 'QUALITY|%s|%s|%s|%s|%s\n' "$E" "$I" "$LOSS" "$AVG" "$MAX"; done; }
cleanup(){ [ -f /etc/config/mwan3 ] || return 0; for S in $(uci show mwan3 2>/dev/null | sed -n 's/^mwan3\.\([^.=]*\)=.*/\1/p' | sort -u); do [ "$(uci -q get mwan3.$S.mrouter_managed)" = 1 ] && uci -q delete mwan3.$S || true; done; }
ensure_mwan_iface(){ I="$1"; if [ "$(uci -q get mwan3.$I)" != interface ]; then uci set mwan3.$I='interface'; uci set mwan3.$I.enabled='1'; uci set mwan3.$I.family='ipv4'; uci add_list mwan3.$I.track_ip='1.1.1.1'; uci add_list mwan3.$I.track_ip='9.9.9.9'; uci set mwan3.$I.reliability='1'; uci set mwan3.$I.count='1'; uci set mwan3.$I.timeout='2'; uci set mwan3.$I.interval='5'; uci set mwan3.$I.down='3'; uci set mwan3.$I.up='3'; uci set mwan3.$I.mrouter_managed='1'; fi; }
save(){ PRI="${2:-}"; SEC="${3:-}"; MODE="${4:-failover}"; safe "$PRI" || exit 1; safe "$SEC" || exit 1; [ "$PRI" != "$SEC" ] || exit 1; [ -n "$(uci -q get network.$PRI)" ] && [ -n "$(uci -q get network.$SEC)" ] || exit 1; case "$MODE" in failover|balance) ;; *) exit 1;; esac; [ -f /etc/config/mwan3 ] || { echo 'mwan3 is not installed' >&2; exit 1; }; cleanup; ensure_mwan_iface "$PRI"; ensure_mwan_iface "$SEC"; PKEY="$(printf '%s' "$PRI" | tr -cd 'A-Za-z0-9_')"; SKEY="$(printf '%s' "$SEC" | tr -cd 'A-Za-z0-9_')"; PM="mrouter_${PKEY}_member"; SM="mrouter_${SKEY}_member"; uci set mwan3.$PM='member'; uci set mwan3.$PM.interface="$PRI"; uci set mwan3.$PM.metric='1'; uci set mwan3.$PM.weight="$([ "$MODE" = balance ] && echo 1 || echo 3)"; uci set mwan3.$PM.mrouter_managed='1'; uci set mwan3.$SM='member'; uci set mwan3.$SM.interface="$SEC"; uci set mwan3.$SM.metric="$([ "$MODE" = balance ] && echo 1 || echo 2)"; uci set mwan3.$SM.weight='1'; uci set mwan3.$SM.mrouter_managed='1'; POL=mrouter_default_policy; uci set mwan3.$POL='policy'; uci add_list mwan3.$POL.use_member="$PM"; uci add_list mwan3.$POL.use_member="$SM"; uci set mwan3.$POL.last_resort='default'; uci set mwan3.$POL.mrouter_managed='1'; RULE=mrouter_default_rule; uci set mwan3.$RULE='rule'; uci set mwan3.$RULE.dest_ip='0.0.0.0/0'; uci set mwan3.$RULE.use_policy="$POL"; uci set mwan3.$RULE.family='ipv4'; uci set mwan3.$RULE.proto='all'; uci set mwan3.$RULE.mrouter_managed='1'; uci set $CFG.main='settings'; uci set $CFG.main.enabled='1'; uci set $CFG.main.primary="$PRI"; uci set $CFG.main.secondary="$SEC"; uci set $CFG.main.mode="$MODE"; uci commit mwan3; uci commit $CFG; /etc/init.d/mwan3 enable >/dev/null 2>&1 || true; /etc/init.d/mwan3 restart >/dev/null 2>&1 || true; status; }
disable(){ cleanup; [ -f /etc/config/mwan3 ] && { uci commit mwan3; /etc/init.d/mwan3 restart >/dev/null 2>&1 || true; }; uci set $CFG.main='settings'; uci set $CFG.main.enabled='0'; uci commit $CFG; status; }
sample(){ I="$(uci -q get $CFG.main.primary || echo wan)"; safe "$I" || I=wan; DEV="$(ubus call network.interface.$I status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"; [ -n "$DEV" ] || DEV="$(uci -q get network.$I.device || true)"; if [ -n "$DEV" ]; then OUT="$(ping -4 -I "$DEV" -c 3 -W 1 1.1.1.1 2>/dev/null || true)"; else OUT="$(ping -4 -c 3 -W 1 1.1.1.1 2>/dev/null || true)"; fi; LOSS="$(printf '%s\n' "$OUT" | sed -n 's/.* \([0-9.]*\)% packet loss.*/\1/p' | tail -n1)"; STATS="$(printf '%s\n' "$OUT" | sed -n 's/.*= \([0-9.]*\)\/\([0-9.]*\)\/\([0-9.]*\)\/.*/\2|\3/p' | tail -n1)"; AVG="${STATS%%|*}"; MAX="${STATS##*|}"; [ -n "$LOSS" ] || LOSS=100; [ -n "$AVG" ] || AVG=0; [ -n "$MAX" ] || MAX=0; printf '%s|%s|%s|%s|%s\n' "$(date +%s)" "$I" "$LOSS" "$AVG" "$MAX" >> "$HIST"; tail -n 1440 "$HIST" > "$HIST.tmp" && mv "$HIST.tmp" "$HIST"; }
case "$ACTION" in status|history) status;; save) save "$@";; disable) disable;; sample) sample;; *) exit 2;; esac
