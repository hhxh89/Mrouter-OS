#!/bin/sh
set -u
ACTION="${1:-status}"; CFG=mrouterwgclient; UPLOAD=/tmp/mrouter-wireguard-client-upload; MAX=16
esc(){ printf '%s' "${1:-}" | tr '|\r\n' '   '; }
safe(){ case "${1:-}" in p[0-9]|p[0-9][0-9]) return 0;; *) return 1;; esac; }
wgget(){ SEC="$1"; KEY="$2"; FILE="$3"; awk -v s="$SEC" -v k="$KEY" 'function t(x){gsub(/^[ \t]+|[ \t]+$/,"",x);return x}/^[ \t]*\[/{x=$0;gsub(/^[ \t]*\[/,"",x);gsub(/\][ \t]*$/,"",x);sec=tolower(t(x));next}sec==tolower(s)&&index($0,"="){line=$0;key=line;sub(/=.*/,"",key);key=tolower(t(key));if(key==tolower(k)){v=line;sub(/^[^=]*=/,"",v);v=t(v);out=(out==""?v:out "," v)}}END{print out}' "$FILE"; }
ids(){ uci show $CFG 2>/dev/null | sed -n "s/^$CFG\.\(p[0-9][0-9]*\)=profile$/\1/p"; }
nextid(){ N=1; while [ "$N" -le "$MAX" ]; do I=p$N; [ "$(uci -q get $CFG.$I)" != profile ] && { echo "$I"; return; }; N=$((N+1)); done; return 1; }
parse_ep(){ E="$1"; case "$E" in \[*\]:*) HOST="${E#\[}"; HOST="${HOST%%\]*}"; PORT="${E##*:}";; *:*) HOST="${E%:*}"; PORT="${E##*:}";; *) return 1;; esac; case "$PORT" in ''|*[!0-9]*) return 1;; esac; [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ]; }
validate(){ F="$1"; [ -s "$F" ] || { echo 'Empty config' >&2; return 1; }; [ "$(wc -c < "$F")" -le 131072 ] || { echo 'Config too large' >&2; return 1; }; [ "$(grep -Eic '^[[:space:]]*\[[[:space:]]*Peer[[:space:]]*\][[:space:]]*$' "$F")" = 1 ] || { echo 'Exactly one [Peer] is supported per profile' >&2; return 1; }; grep -Eiq '^[[:space:]]*(PreUp|PostUp|PreDown|PostDown|SaveConfig|Table)[[:space:]]*=' "$F" && { echo 'wg-quick script/routing directives are not imported' >&2; return 1; }; for X in PrivateKey Address; do [ -n "$(wgget Interface "$X" "$F")" ] || { echo "Interface $X missing" >&2; return 1; }; done; for X in PublicKey Endpoint AllowedIPs; do [ -n "$(wgget Peer "$X" "$F")" ] || { echo "Peer $X missing" >&2; return 1; }; done; }
firewall(){ for S in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.\(mrouter_wg_vpn_[^.=]*\)=forwarding$/\1/p'); do uci -q delete firewall.$S; done; uci -q delete firewall.mrouter_wg_vpn_zone; uci set firewall.mrouter_wg_vpn_zone='zone'; uci set firewall.mrouter_wg_vpn_zone.name='mrouter_wg_vpn'; uci set firewall.mrouter_wg_vpn_zone.input='REJECT'; uci set firewall.mrouter_wg_vpn_zone.output='ACCEPT'; uci set firewall.mrouter_wg_vpn_zone.forward='REJECT'; uci set firewall.mrouter_wg_vpn_zone.masq='1'; uci set firewall.mrouter_wg_vpn_zone.mtu_fix='1'; for ID in $(ids); do I="$(uci -q get $CFG.$ID.interface)"; [ -n "$I" ] && uci add_list firewall.mrouter_wg_vpn_zone.network="$I"; done; N=0; for F in $(uci show firewall 2>/dev/null | sed -n 's/^firewall\.\([^.=]*\)=forwarding$/\1/p'); do [ "$(uci -q get firewall.$F.dest)" = wan ] || continue; SRC="$(uci -q get firewall.$F.src)"; [ -n "$SRC" ] || continue; N=$((N+1)); S="mrouter_wg_vpn_fwd_$N"; uci set firewall.$S='forwarding'; uci set firewall.$S.src="$SRC"; uci set firewall.$S.dest='mrouter_wg_vpn'; done; uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1 || true; }
status(){ C=0; for ID in $(ids); do C=$((C+1)); done; printf 'STATUS|%s\n' "$C"; for ID in $(ids); do NAME="$(uci -q get $CFG.$ID.name)"; I="$(uci -q get $CFG.$ID.interface)"; END="$(uci -q get $CFG.$ID.endpoint)"; DNS="$(uci -q get $CFG.$ID.dns)"; FULL="$(uci -q get $CFG.$ID.full_ipv4 || echo 0)"; DIS="$(uci -q get network.$I.disabled || echo 0)"; EN=1; [ "$DIS" = 1 ] && EN=0; UP=0; wg show "$I" >/dev/null 2>&1 && UP=1 || true; H=0; RX=0; TX=0; if [ "$UP" = 1 ]; then H="$(wg show "$I" latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')"; T="$(wg show "$I" transfer 2>/dev/null | awk 'NR==1{print $2"|"$3}')"; RX="${T%%|*}"; TX="${T##*|}"; fi; case "$H" in ''|*[!0-9]*) H=0;; esac; NOW="$(date +%s)"; AGE=0; HEALTH=0; [ "$H" -gt 0 ] 2>/dev/null && { AGE=$((NOW-H)); [ "$AGE" -le 180 ] && HEALTH=1 || true; }; ADDR="$(uci -q get network.$I.addresses 2>/dev/null | tr ' ' ',')"; printf 'PROFILE|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$ID" "$(esc "$NAME")" "$I" "$EN" "$UP" "$HEALTH" "$AGE" "$(esc "$END")" "$(esc "$ADDR")" "$(esc "$DNS")" "${RX:-0}" "${TX:-0}" "$FULL"; done; }
importp(){ NAMEFILE="${2:-profile.conf}"; [ -f "$UPLOAD" ] || { echo 'Upload missing' >&2; exit 1; }; validate "$UPLOAD" || exit 1; ID="$(nextid)" || exit 1; N="${ID#p}"; I="mwg$N"; P="${I}_peer"; PRIV="$(wgget Interface PrivateKey "$UPLOAD")"; ADDR="$(wgget Interface Address "$UPLOAD")"; DNS="$(wgget Interface DNS "$UPLOAD")"; MTU="$(wgget Interface MTU "$UPLOAD")"; PUB="$(wgget Peer PublicKey "$UPLOAD")"; PSK="$(wgget Peer PresharedKey "$UPLOAD")"; END="$(wgget Peer Endpoint "$UPLOAD")"; ALLOWED="$(wgget Peer AllowedIPs "$UPLOAD")"; KEEP="$(wgget Peer PersistentKeepalive "$UPLOAD")"; parse_ep "$END" || exit 1; NAME="$(basename "$NAMEFILE" | sed -E 's/\.[Cc][Oo][Nn][Ff]$//' | cut -c1-64)"; [ -n "$NAME" ] || NAME="WireGuard VPN $N"; uci -q delete network.$I; uci set network.$I='interface'; uci set network.$I.proto='wireguard'; uci set network.$I.private_key="$PRIV"; uci set network.$I.disabled='1'; [ -n "$MTU" ] && uci set network.$I.mtu="$MTU"; OLD="$IFS"; IFS=','; for A in $ADDR; do A="$(printf '%s' "$A" | xargs)"; [ -n "$A" ] && uci add_list network.$I.addresses="$A"; done; IFS="$OLD"; uci -q delete network.$P; uci set network.$P="wireguard_$I"; uci set network.$P.description="$NAME"; uci set network.$P.public_key="$PUB"; uci set network.$P.endpoint_host="$HOST"; uci set network.$P.endpoint_port="$PORT"; [ -n "$PSK" ] && uci set network.$P.preshared_key="$PSK"; [ -n "$KEEP" ] && uci set network.$P.persistent_keepalive="$KEEP"; uci set network.$P.route_allowed_ips='0'; FULL=0; LO=0; HI=0; OLD="$IFS"; IFS=','; for A in $ALLOWED; do A="$(printf '%s' "$A" | xargs)"; [ -n "$A" ] || continue; uci add_list network.$P.allowed_ips="$A"; [ "$A" = 0.0.0.0/0 ] && FULL=1; [ "$A" = 0.0.0.0/1 ] && LO=1; [ "$A" = 128.0.0.0/1 ] && HI=1; done; IFS="$OLD"; [ "$LO$HI" = 11 ] && FULL=1; uci commit network; uci set $CFG.$ID='profile'; uci set $CFG.$ID.name="$NAME"; uci set $CFG.$ID.interface="$I"; uci set $CFG.$ID.peer="$P"; uci set $CFG.$ID.endpoint="$END"; uci set $CFG.$ID.dns="$DNS"; uci set $CFG.$ID.full_ipv4="$FULL"; uci commit $CFG; firewall; rm -f "$UPLOAD"; status; }
connectp(){ ID="${2:-}"; safe "$ID" || exit 1; I="$(uci -q get $CFG.$ID.interface)"; [ -n "$I" ] || exit 1; uci set network.$I.disabled='0'; uci commit network; ifup "$I" >/dev/null 2>&1 || true; sleep 1; status; }
disconnectp(){ ID="${2:-}"; safe "$ID" || exit 1; I="$(uci -q get $CFG.$ID.interface)"; [ -n "$I" ] || exit 1; uci set network.$I.disabled='1'; uci commit network; ifdown "$I" >/dev/null 2>&1 || true; status; }
delp(){ ID="${2:-}"; safe "$ID" || exit 1; I="$(uci -q get $CFG.$ID.interface)"; P="$(uci -q get $CFG.$ID.peer)"; [ -n "$I" ] || exit 1; ifdown "$I" >/dev/null 2>&1 || true; uci -q delete network.$P; uci -q delete network.$I; uci -q delete $CFG.$ID; uci commit network; uci commit $CFG; firewall; status; }
renamep(){ ID="${2:-}"; NAME="${3:-}"; safe "$ID" || exit 1; [ -n "$NAME" ] || exit 1; P="$(uci -q get $CFG.$ID.peer)"; uci set $CFG.$ID.name="$NAME"; [ -n "$P" ] && uci set network.$P.description="$NAME"; uci commit $CFG; uci commit network; status; }
case "$ACTION" in status) status;; import) importp "$@";; connect) connectp "$@";; disconnect) disconnectp "$@";; delete) delp "$@";; rename) renamep "$@";; *) exit 2;; esac
