#!/bin/sh
set -u
ACTION="${1:-status}"
esc(){ printf '%s' "${1:-}" | tr '|\r\n' '   '; }
safe(){ printf '%s\n' "${1:-}" | grep -Eq '^[A-Za-z0-9_]+$'; }
commit_reload(){ uci commit wireless; wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true; }
status(){
    RADIOS="$(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')"
    COUNT=0; for R in $RADIOS; do COUNT=$((COUNT+1)); done
    printf 'STATUS|%s\n' "$COUNT"
    for R in $RADIOS; do
        DIS="$(uci -q get wireless.$R.disabled || echo 0)"; CH="$(uci -q get wireless.$R.channel || true)"; MODE="$(uci -q get wireless.$R.htmode || true)"; COUNTRY="$(uci -q get wireless.$R.country || true)"; TX="$(uci -q get wireless.$R.txpower || true)"; BAND="$(uci -q get wireless.$R.band || true)"; TYPE="$(uci -q get wireless.$R.type || true)"
        printf 'RADIO|%s|%s|%s|%s|%s|%s|%s|%s\n' "$R" "$([ "$DIS" = 1 ] && echo 0 || echo 1)" "$(esc "$BAND")" "$(esc "$CH")" "$(esc "$MODE")" "$(esc "$COUNTRY")" "$(esc "$TX")" "$(esc "$TYPE")"
    done
    for S in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do DEV="$(uci -q get wireless.$S.device || true)"; NET="$(uci -q get wireless.$S.network || true)"; SSID="$(uci -q get wireless.$S.ssid || true)"; ENC="$(uci -q get wireless.$S.encryption || echo none)"; MODE="$(uci -q get wireless.$S.mode || echo ap)"; DIS="$(uci -q get wireless.$S.disabled || echo 0)"; printf 'SSID|%s|%s|%s|%s|%s|%s|%s\n' "$S" "$(esc "$DEV")" "$(esc "$NET")" "$(esc "$SSID")" "$(esc "$ENC")" "$([ "$DIS" = 1 ] && echo 0 || echo 1)" "$(esc "$MODE")"; done
}
radio_save(){ R="${2:-}"; EN="${3:-1}"; CH="${4:-auto}"; MODE="${5:-}"; COUNTRY="${6:-}"; TX="${7:-}"; safe "$R" || { echo 'Invalid radio' >&2; exit 1; }; [ "$(uci -q get wireless.$R)" = wifi-device ] || { echo 'Radio not found' >&2; exit 1; }; case "$EN" in 0|1) ;; *) exit 1;; esac; uci set wireless.$R.disabled="$([ "$EN" = 1 ] && echo 0 || echo 1)"; [ -n "$CH" ] && uci set wireless.$R.channel="$CH"; [ -n "$MODE" ] && uci set wireless.$R.htmode="$MODE"; [ -n "$COUNTRY" ] && uci set wireless.$R.country="$COUNTRY"; if [ -n "$TX" ]; then case "$TX" in *[!0-9]*) echo 'Invalid TX power' >&2; exit 1;; esac; uci set wireless.$R.txpower="$TX"; fi; commit_reload; status; }
ssid_save(){ S="${2:-}"; EN="${3:-1}"; SSID="${4:-}"; ENC="${5:-none}"; KEY="${6:-}"; NET="${7:-lan}"; safe "$S" || exit 1; [ "$(uci -q get wireless.$S)" = wifi-iface ] || { echo 'SSID section not found' >&2; exit 1; }; [ -n "$SSID" ] || { echo 'SSID is required' >&2; exit 1; }; case "$EN" in 0|1) ;; *) exit 1;; esac; case "$ENC" in none|psk2|psk-mixed|sae|sae-mixed) ;; *) echo 'Unsupported encryption' >&2; exit 1;; esac; uci set wireless.$S.disabled="$([ "$EN" = 1 ] && echo 0 || echo 1)"; uci set wireless.$S.ssid="$SSID"; uci set wireless.$S.encryption="$ENC"; uci set wireless.$S.network="$NET"; if [ "$ENC" = none ]; then uci -q delete wireless.$S.key; else if [ -n "$KEY" ]; then [ ${#KEY} -ge 8 ] || { echo 'Wi-Fi key must be at least 8 characters' >&2; exit 1; }; uci set wireless.$S.key="$KEY"; elif [ -z "$(uci -q get wireless.$S.key)" ]; then echo 'Wi-Fi key is required' >&2; exit 1; fi; fi; commit_reload; status; }
add_ssid(){ DEV="${2:-}"; NET="${3:-lan}"; SSID="${4:-}"; ENC="${5:-sae-mixed}"; KEY="${6:-}"; safe "$DEV" || exit 1; [ "$(uci -q get wireless.$DEV)" = wifi-device ] || { echo 'Radio not found' >&2; exit 1; }; [ -n "$SSID" ] || exit 1; SEC="mrouter_$(date +%s)_$$"; uci set wireless.$SEC='wifi-iface'; uci set wireless.$SEC.device="$DEV"; uci set wireless.$SEC.mode='ap'; uci set wireless.$SEC.network="$NET"; uci set wireless.$SEC.ssid="$SSID"; uci set wireless.$SEC.encryption="$ENC"; uci set wireless.$SEC.mrouter_managed='1'; if [ "$ENC" != none ]; then [ ${#KEY} -ge 8 ] || { uci -q delete wireless.$SEC; echo 'Wi-Fi key must be at least 8 characters' >&2; exit 1; }; uci set wireless.$SEC.key="$KEY"; fi; commit_reload; status; }
delete_ssid(){ S="${2:-}"; safe "$S" || exit 1; [ "$(uci -q get wireless.$S.mrouter_managed)" = 1 ] || { echo 'Only Mrouter-created SSIDs can be deleted here' >&2; exit 1; }; uci -q delete wireless.$S; commit_reload; status; }
case "$ACTION" in status) status;; radio-save) radio_save "$@";; ssid-save) ssid_save "$@";; add-ssid) add_ssid "$@";; delete-ssid) delete_ssid "$@";; *) echo 'Unknown action' >&2; exit 2;; esac
